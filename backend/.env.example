# Scuffed OS backend configuration — copy to backend/.env and fill in.
# Values here are read by app/config.py (pydantic-settings); .env is gitignored.

# Anthropic API key — powers the real assistant (milestone M2+).
ANTHROPIC_API_KEY=

# OpenAI API key — used ONLY by Mem0's embedder (Anthropic has no embeddings
# API). Required when MEMORY_ENABLED=true; the assistant never calls OpenAI.
OPENAI_API_KEY=

# Postgres connection string. Production: the Supabase *session pooler* URL
# (Dashboard → Connect → Session pooler; the direct db.<ref>.supabase.co host is
# IPv6-only on the free tier). Pasting the raw postgresql:// string is fine —
# the app normalizes it to the psycopg driver.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development fallback (docker: pgvector/pgvector:pg17 on port 5433):
DATABASE_URL=postgresql://scuffed:scuffed@localhost:5433/scuffedos

# Allowed CORS origins as a JSON list (defaults cover the Vite dev server).
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Assistant (M2) — all optional, sensible defaults in app/config.py ---
# Chat tier and heavy-work tier models:
# ASSISTANT_MODEL=claude-haiku-4-5
# ASSISTANT_HEAVY_MODEL=claude-opus-4-8
# Mem0 memory engine: uses the OpenAI embedder above (set OPENAI_API_KEY).
# Set MEMORY_ENABLED=false to run without it (chat still works).
# MEMORY_ENABLED=true

# --- Local domains (M3) — all optional ---
# Task attachments land here (bytes; metadata stays on the task row):
# ATTACHMENTS_DIR=./data/attachments
# Reminder scheduler (macOS notifications via osascript):
# REMINDERS_ENABLED=true
# REMINDER_TICK_SECONDS=30
# USDA FoodData Central key for "chicken wrap" → macros. DEMO_KEY works but
# is rate-limited; grab a free key at https://api.data.gov/signup/
# FDC_API_KEY=DEMO_KEY
