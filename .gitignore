# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node (frontend has its own .gitignore too)
node_modules/

# OS / editor
.DS_Store
.idea/

# Secrets & local data
.env
*.db
*.sqlite3
backend/data/attachments/
.claude/settings.local.json

# Design bundle working artifacts (extracted reference kept in design-system/)
design_download/
build/
src-tauri/target/
src-tauri/gen/
src-tauri/launcher/target/

# build-app.sh generated artifacts (compiled sidecar binary, rendered .icns) -
# regenerated by scripts/build-app.sh; keep only the .gitkeep placeholder and
# the committed icon.png source tracked.
src-tauri/binaries/scuffedos-backend-*
src-tauri/icons/icon.icns

# graphify knowledge-graph output (local tooling, regenerable)
graphify-out/

# Local agent tooling scratch (not part of the app):
# .agents/ duplicates the tracked .claude/skills/ and vendors a node_modules;
# .superpowers/ is per-session review diffs, task briefs, and port/token files;
# .beans/ + .beans.yml are the local task-tracker's config and store.
.agents/
.superpowers/
.beans/
.beans.yml
backend/.beans.yml
